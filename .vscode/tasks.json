{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "caddy: run",
      "type": "shell",
      "command": "& 'C:\\Tools\\Caddy\\caddy.exe' run --config '${workspaceFolder}\\deploy\\caddy\\Caddyfile'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "caddy",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "serving initial configuration"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "caddy"
      }
    },
    {
      "label": "caddy: stop",
      "type": "shell",
      "command": "Stop-Process -Name caddy -Force -ErrorAction SilentlyContinue",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "seed: deviation test log",
      "type": "shell",
      "command": "& '${workspaceFolder}\\.venv\\Scripts\\python.exe' -m scripts.seed_deviation_test_log --force",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "seed: flow balance test log",
      "type": "shell",
      "command": "& '${workspaceFolder}\\.venv\\Scripts\\python.exe' -m scripts.seed_flow_balance_test_log --force",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "docker: build earnie",
      "type": "shell",
      "command": "& '${workspaceFolder}\\.venv\\Scripts\\python.exe' -m scripts.build_container --target synology",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "docker: build + push earnie",
      "type": "shell",
      "command": "& '${workspaceFolder}\\.venv\\Scripts\\python.exe' -m scripts.build_container --target synology --push --versioned-only",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "docker: build + load NAS (ssh earnie-nas)",
      "type": "shell",
      "command": "$v = & '${workspaceFolder}\\.venv\\Scripts\\python.exe' -c 'from version import __version__; print(__version__)'; & '${workspaceFolder}\\.venv\\Scripts\\python.exe' -m scripts.build_container --target synology; if ($LASTEXITCODE -eq 0) { cmd /c ('docker save ghcr.io/jochentcc/earnie-energy:' + $v + ' | ssh -o BatchMode=yes earnie-nas sudo /usr/local/bin/docker load') }; exit $LASTEXITCODE",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      }
    }
  ]
}
