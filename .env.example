# earnie_env/config/.env (Prod/Docker) bzw. ./.env (lokale Dev – Legacy-Fallback)
# Kopiere diese Datei nach earnie_env/config/.env und fülle die Werte aus.
LOXONE_USER="name-des-benutzers-in-der-loxone"
LOXONE_PASS="Passwort-des-benutzers-in-der-loxone"
# IPv4; optionaler HTTP-Port z. B. 192.168.178.1:85 (ohne Angabe: Port 80)
LOXONE_IP=192.168.178.1

# Heimnetz für aktive LAN-Suche (OpenEMS-Portscan) im Container — /24 CIDR.
# LoxBerry setzt das beim Install aus der Host-IP; Compose/Synology: hier eintragen.
# Fehlt die Variable und die Container-IP liegt in 172.16.0.0/12, fragt die UI nach.
# EARNIE_LAN_SUBNET=192.168.178.0/24

# Home Assistant (ehal.backend=ha): keine Zugangsdaten noetig - Home Assistant ruft Earnie
# auf (Push, Port 8541). EHAL_HA_BASE_URL / EHAL_HA_TOKEN werden nicht mehr verwendet.

# ENTSO-E Transparency Platform (optional Live Day-Ahead; skipped if unset)
# ENTSOE_API_TOKEN="your-transparency-token"

# Persistenz-Wurzel (Standard: earnie_env → …/config und …/runtime)
# EARNIE_ENV_PATH=earnie_env

# Config-Verzeichnis (Standard: earnie_env/config; enthält config.json, Sidecars, .env, uploads/)
# EARNIE_CONFIG_PATH=earnie_env/config

# Laufzeitdaten (Standard: earnie_env/runtime; oder abgeleitet aus EARNIE_ENV_PATH)
# EARNIE_RUNTIME_PATH=earnie_env/runtime

# Maschinenspezifische Einstellungen (Standard: {runtime}/local_settings.json)
# EARNIE_LOCAL_SETTINGS_PATH=earnie_env/runtime/local_settings.json
