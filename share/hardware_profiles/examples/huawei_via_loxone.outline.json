{
  "vendor": "Huawei",
  "model": "Luna / inverter via Loxone markers (outline)",
  "protocol": "proprietary",
  "status": "outline",
  "notes": "Design C1: Live writes set_ess_active_power + true charge/discharge limits + set_ess_mode hint (control_cmd). Ziel-SOC removed in 2.4.j. Register addresses illustrative for future Path D.",
  "registers": [
    {
      "address": 47000,
      "type": "uint16",
      "name": "Battery_SoC",
      "scale": 1,
      "unit": "%",
      "direction": "read",
      "notes": "Placeholder — today read via Loxone Merker (soc_name / sens_ess_soc)."
    },
    {
      "address": 47001,
      "type": "int16",
      "name": "Battery_Power",
      "scale": 0.001,
      "unit": "kW",
      "direction": "read",
      "notes": "Placeholder — Loxone marker often in kW with +charge; EHAL needs W and +discharge."
    },
    {
      "address": 47101,
      "type": "uint16",
      "name": "Control_Cmd",
      "scale": 1,
      "unit": "",
      "direction": "write",
      "notes": "Mapped via set_ess_mode / control_cmd_name (hint; OpenEMS ignores)."
    },
    {
      "address": 47100,
      "type": "int16",
      "name": "Active_Power_Setpoint",
      "scale": 1,
      "unit": "W",
      "direction": "write",
      "notes": "EHAL set_ess_active_power (+discharge); Loxone maps via target_active_power_name."
    },
    {
      "address": 47102,
      "type": "uint16",
      "name": "Charge_Power_Limit",
      "scale": 1,
      "unit": "W",
      "direction": "write",
      "notes": "EHAL set_ess_charge_power_limit (true cap)."
    },
    {
      "address": 47103,
      "type": "uint16",
      "name": "Discharge_Power_Limit",
      "scale": 1,
      "unit": "W",
      "direction": "write",
      "notes": "EHAL set_ess_discharge_power_limit (true cap)."
    }
  ],
  "ehal_bindings": [
    {
      "source": "Battery_SoC",
      "ehal_field": "sens_ess_soc",
      "scale": 1,
      "negate": false
    },
    {
      "source": "Battery_Power",
      "ehal_field": "sens_ess_power",
      "scale": 1000,
      "negate": true,
      "transform_note": "kW→W and invert +charge → EHAL +discharge (matches loxone_adapter)."
    },
    {
      "source": "Active_Power_Setpoint",
      "ehal_field": "set_ess_active_power",
      "scale": 1,
      "negate": false,
      "transform_note": "Signed W; +discharge −charge."
    },
    {
      "source": "Charge_Power_Limit",
      "ehal_field": "set_ess_charge_power_limit",
      "scale": 1,
      "negate": false
    },
    {
      "source": "Discharge_Power_Limit",
      "ehal_field": "set_ess_discharge_power_limit",
      "scale": 1,
      "negate": false
    },
    {
      "source": "Control_Cmd",
      "ehal_field": "set_ess_mode",
      "scale": 1,
      "negate": false,
      "transform_note": "Huawei control command via markers."
    }
  ]
}
