{
  "version": 1,
  "description": "2.4.n greenfield import contract: match loxapp3 control Bezeichnung to HK entity + ehal_bindings. Exact names preferred; prefix groups multi-signal devices. EFM meter roles still apply per docs/spec/efm-auto-sync-2.4.l.md.",
  "markers": [
    {
      "name": "Earnie_Heartbeat",
      "match": "exact",
      "entity_kind": "plant",
      "ehal_field": null,
      "notes": "Pattern B Virtual In: Earnie liveness (unix ts or age). Watchdog only; not an EHAL wire field."
    },
    {
      "name": "Earnie_Netzleistung",
      "match": "exact",
      "entity_kind": "plant",
      "ehal_field": "sens_grid_power_active",
      "notes": "kW +Bezug. Prefer EFM Grid meter Bezeichnung when present."
    },
    {
      "name": "Earnie_PV_Leistung",
      "match": "exact",
      "entity_kind": "plant",
      "ehal_field": "sens_pv_production_active",
      "notes": "kW production. Prefer EFM Production meter when present."
    },
    {
      "name": "Earnie_Batterie_SoC",
      "match": "exact",
      "entity_kind": "plant",
      "ehal_field": "sens_ess_soc"
    },
    {
      "name": "Earnie_Batterie_Leistung",
      "match": "exact",
      "entity_kind": "plant",
      "ehal_field": "sens_ess_power",
      "notes": "Prefer EFM Storage meter for power; SoC often separate Merker. Pattern B VO optional."
