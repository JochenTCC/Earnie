<?xml version="1.0" encoding="utf-8"?>
<!--
  DRAFT (2.4.n Pattern B) — Loxone → Earnie EV telemetry push.
  Replace EARNIE_HOST and {ev_id} (HK EV id, e.g. ev). Paths are placeholders until Earnie exposes ingest.
  Cmd Titles = frozen Merker names. Multi-EV: Prefix+Slug Titles (Earnie_EAuto_<Slug>_…).
  Earnie_EAuto_Leistung may be EFM Load — keep VO cmd. Legacy Title Earnie_EAuto_P_act still valid.
  FertigUm / get_evcs_ready_by_time: Analog VO pushes numeric next-entry (or raw text); when consumer is on ehal.loxone_push.entities Earnie reads the inbox, else AlarmClock SpecialState10 via /all (Tna backup).
  Value placeholder in a Virtual Output command is <v> (verified 2026-10-07 with a capture: the Virtual-Input style \v is sent as the
  control character 0x0B). <v> arrives with a point and 3 decimals (e.g. 6.333). In the XML attribute it is written &lt;v&gt;.
  Pilot (branch spike/vo-push-pilot): target is the daemon port 8541 (not the Streamlit port 8501); append ?t=TOKEN to the command
  (EARNIE_PILOT_PUSH_TOKEN). Repeat (e.g. 30 s) is set per command in Config.
-->
<VirtualOut HintText="" Title="Earnie EV Telemetry" Comment="Pattern B: push EV sens_*/get_* to Earnie (draft)" Address="http://EARNIE_HOST:8541" CmdInit="" CloseAfterSend="true" CmdSep="">
	<Info templateType="3" minVersion="17010630"/>
	<VirtualOutCmd Title="Earnie_EAuto_Angeschlossen" Comment="ev.{ev_id}.sens_evcs_connected 0/1" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ev.{ev_id}.sens_evcs_connected/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="false" Repeat="0" RepeatRate="0" HintText=""/>
