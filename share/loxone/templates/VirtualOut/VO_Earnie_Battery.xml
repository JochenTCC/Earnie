<?xml version="1.0" encoding="utf-8"?>
<!--
  VO battery telemetry (2.7.q / Pilot): Titles = Push_<EHAL-ID> (dots → _), same as pilot_vo_template_gen.
  Replace {bat_id} with the battery Kennung (e.g. 15_kwh_speicher). Per-battery ess.{bat_id}.* only —
  not on Plant VO. Bipolar energy: charge + discharge (Q6). Optional get_ess_* for limits_from_live.
  Value placeholder is <v> (written &lt;v&gt; in XML). Daemon port 8541; append ?t=TOKEN (EARNIE_PILOT_PUSH_TOKEN).
-->
<VirtualOut HintText="" Title="Earnie Battery Telemetry" Comment="Push ess.{bat_id}.* telemetry (SoC/power/energy/get_*)" Address="http://EARNIE_HOST:8541" CmdInit="" CloseAfterSend="true" CmdSep="">
	<Info templateType="3" minVersion="17010630"/>
	<VirtualOutCmd Title="Push_ess_{bat_id}_sens_ess_soc" Comment="ess.{bat_id}.sens_ess_soc SoC %" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ess.{bat_id}.sens_ess_soc/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
	<VirtualOutCmd Title="Push_ess_{bat_id}_sens_ess_power" Comment="ess.{bat_id}.sens_ess_power kW; +discharge; or EFM Storage" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ess.{bat_id}.sens_ess_power/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
	<VirtualOutCmd Title="Push_ess_{bat_id}_sens_ess_energy_charge" Comment="ess.{bat_id}.sens_ess_energy_charge kWh cumulative charge (Q6; Meter total)" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ess.{bat_id}.sens_ess_energy_charge/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
	<VirtualOutCmd Title="Push_ess_{bat_id}_sens_ess_energy_discharge" Comment="ess.{bat_id}.sens_ess_energy_discharge kWh cumulative discharge (Q6 bipolar; Meter totalNeg)" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ess.{bat_id}.sens_ess_energy_discharge/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
	<VirtualOutCmd Title="Push_ess_{bat_id}_get_ess_soc_min" Comment="ess.{bat_id}.get_ess_soc_min optional discharge cut-off %" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ess.{bat_id}.get_ess_soc_min/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
	<VirtualOutCmd Title="Push_ess_{bat_id}_get_ess_soc_max" Comment="ess.{bat_id}.get_ess_soc_max optional charge cut-off %" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ess.{bat_id}.get_ess_soc_max/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
	<VirtualOutCmd Title="Push_ess_{bat_id}_get_ess_max_charge_power" Comment="ess.{bat_id}.get_ess_max_charge_power optional device max charge kW" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ess.{bat_id}.get_ess_max_charge_power/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
	<VirtualOutCmd Title="Push_ess_{bat_id}_get_ess_max_discharge_power" Comment="ess.{bat_id}.get_ess_max_discharge_power optional device max discharge kW" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/ess.{bat_id}.get_ess_max_discharge_power/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
</VirtualOut>
