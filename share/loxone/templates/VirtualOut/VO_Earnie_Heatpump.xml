	<VirtualOutCmd Title="Earnie_Waermepumpe_Leistung" Comment="flex.{hk_id}.sens_power_act; or EFM Load" CmdOnMethod="GET" CmdOffMethod="GET" CmdOn="/ehal/loxone/telemetry/flex.{hk_id}.sens_power_act/&lt;v&gt;" CmdOnHTTP="" CmdOnPost="" CmdOff="" CmdOffHTTP="" CmdOffPost="" CmdAnswer="" Analog="true" Repeat="0" RepeatRate="0" SourceValLow="0" DestValLow="0" SourceValHigh="0" DestValHigh="0" HintText=""/>
