{
  "role_id": "ess",
  "label": "Batterie (ESS)",
  "description": "Home battery SoC, optional power, active-power setpoint (Design C1), true charge/discharge limits, and sticky-backend mode control.",
  "status": "m1",
  "ehal_fields": [
    {
      "field": "sens_ess_soc",
      "required": true,
      "kind": "telemetry",
      "notes": "SoC in % (0…100).",
      "loxone": {
        "unit": "%",
        "ehal_unit": "%",
        "factor": 1,
        "sign": 1,
        "read_required": true
      }
    },
    {
      "field": "sens_ess_power",
      "required": false,
      "kind": "telemetry",
      "notes": "Optional W; + = discharge, − = charge (OpenEMS-aligned).",
      "loxone": {
        "unit": "kW",
        "ehal_unit": "W",
        "factor": 1000,
        "sign": 1,
        "read_required": true
      }
    },
    {
      "field": "sens_ess_energy_charge",
      "required": false,
      "kind": "telemetry",
      "notes": "Cumulative charge kWh (Q6 VO push; Loxone Meter total). Exchange: ess.{id}.sens_ess_energy_charge."
    },
    {
      "field": "sens_ess_energy_discharge",
      "required": false,
      "kind": "telemetry",
      "notes": "Cumulative discharge kWh (Q6 bipolar; Loxone Meter totalNeg). Exchange: ess.{id}.sens_ess_energy_discharge."
    },
    {
      "field": "get_ess_soc_min",
      "required": false,
      "kind": "telemetry",
      "notes": "Optional discharge cut-off SoC in % (device config; MILP when limits_from_live).",
      "loxone": {
        "unit": "%",
        "ehal_unit": "%",
        "factor": 1,
        "sign": 1,
        "clamp_min": 0,
        "clamp_max": 100,
        "read_required": false
      }
    },
    {
      "field": "get_ess_soc_max",
      "required": false,
      "kind": "telemetry",
      "notes": "Optional charge cut-off SoC in % (device config; MILP when limits_from_live).",
      "loxone": {
        "unit": "%",
        "ehal_unit": "%",
        "factor": 1,
        "sign": 1,
        "clamp_min": 0,
        "clamp_max": 100,
        "read_required": false
      }
    },
    {
      "field": "get_ess_max_charge_power",
      "required": false,
      "kind": "telemetry",
      "notes": "Optional device max charge power in W (magnitude ≥ 0; Huawei 47075).",
      "loxone": {
        "unit": "kW",
        "ehal_unit": "W",
        "factor": 1000,
        "sign": 1,
        "omit_if": "negative",
        "read_required": false
      }
    },
    {
      "field": "get_ess_max_discharge_power",
      "required": false,
      "kind": "telemetry",
      "notes": "Optional device max discharge power in W (magnitude ≥ 0; Huawei 47077).",
      "loxone": {
        "unit": "kW",
        "ehal_unit": "W",
        "factor": 1000,
        "sign": 1,
        "omit_if": "negative",
        "read_required": false
      }
    },
    {
      "field": "set_ess_active_power",
      "required": false,
      "kind": "setpoint",
      "notes": "Forced active power in W (+discharge, −charge). Omit on Automatik. Design C1.",
      "loxone": {
        "unit": "kW",
        "ehal_unit": "W",
        "factor": 1000,
        "sign": 1
      }
    },
    {
      "field": "set_ess_charge_power_limit",
      "required": false,
      "kind": "setpoint",
      "notes": "Max charge power magnitude in W (true cap).",
      "loxone": {
        "unit": "kW",
        "ehal_unit": "W",
        "factor": 1000,
        "sign": 1,
        "clamp_min": 0
      },
      "openems": {
        "unit": "W",
        "ehal_unit": "W",
        "factor": 1,
        "sign": -1,
        "clamp_min": 0
      }
    },
    {
      "field": "set_ess_discharge_power_limit",
      "required": false,
      "kind": "setpoint",
      "notes": "Max discharge power magnitude in W (true cap).",
      "loxone": {
        "unit": "kW",
        "ehal_unit": "W",
        "factor": 1000,
        "sign": 1,
        "clamp_min": 0
      },
      "openems": {
        "unit": "W",
        "ehal_unit": "W",
        "factor": 1,
        "sign": 1,
        "clamp_min": 0
      }
    },
    {
      "field": "set_ess_mode",
      "required": false,
      "kind": "setpoint",
      "notes": "Sticky-backend control (Loxone/HA): always write; 0 = Automatik even if Sollleistung Merker is stale. OpenEMS ignores."
    },
    {
      "field": "set_ess_source_select",
      "required": false,
      "kind": "setpoint",
      "notes": "0 = grid pass-through, 1 = battery-only island. Powerstation standby_backup (2.7.h); omit for bidirectional house ESS."
    },
    {
      "field": "supports_ess_write",
      "required": true,
      "kind": "capability",
      "notes": "True when ESS setpoint writes are available."
    },
    {
      "field": "supports_ess_source_select",
      "required": false,
      "kind": "capability",
      "notes": "True when set_ess_source_select can be written (standby_backup)."
    }
  ],
  "capability_expectations": {
    "supports_ess_write": true
  },
  "unit_sign_notes": "See docs/spec/ehal.md § Units and sign convention."
}
