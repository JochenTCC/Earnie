{
  "role_id": "evcs",
  "label": "Wallbox (EVCS)",
  "description": "EV charge point telemetry, current/mode setpoints, and schedule inputs.",
  "status": "m1",
  "ehal_fields": [
    {
      "field": "sens_evcs_active_power",
      "required": false,
      "kind": "telemetry",
      "notes": "Optional W; charge power ≥ 0 when present."
    },
    {
      "field": "sens_evcs_connected",
      "required": false,
      "kind": "telemetry",
      "notes": "EV plugged in / connected."
    },
    {
      "field": "sens_evcs_soc_act",
      "required": false,
      "kind": "telemetry",
      "notes": "Vehicle SoC in %."
    },
    {
      "field": "get_evcs_nominal_current",
      "required": false,
      "kind": "input",
      "notes": "Nominal / max current in A; power = f(A, V, phases)."
    },
    {
      "field": "sens_evcs_bat_capacity",
      "required": false,
      "kind": "telemetry",
      "notes": "EV battery capacity in kWh."
    },
    {
      "field": "get_evcs_ready_by_time",
      "required": false,
      "kind": "input",
      "notes": "Ready-by deadline: bind AlarmClock Bezeichnung (e.g. Ladewecker); prefer SpecialState10 (nextEntryTime) via /all; Tna text is backup."
    },
    {
      "field": "get_evcs_limit_soc",
      "required": false,
      "kind": "input",
      "notes": "Charge limit SoC % (Merker mapping in 2.4.k)."
    },
    {
      "field": "set_evcs_max_current",
      "required": false,
      "kind": "setpoint",
      "notes": "EV charge current setpoint / max current in A (replaces kW power_setpoint)."
    },
    {
      "field": "set_evcs_mode",
      "required": false,
      "kind": "setpoint",
      "notes": "Enum off | pv | now (replaces pv_follow + charge_immediate markers; Loxone numeric 0/1/2)."
    },
    {
      "field": "supports_evcs_current",
      "required": true,
      "kind": "capability",
      "notes": "True when set_evcs_max_current writes work."
    }
  ],
  "capability_expectations": {
    "supports_evcs_current": true
  },
  "unit_sign_notes": "See docs/spec/ehal.md § Units and sign convention."
}
