{
  "ehal": {
    "backend": "ha",
    "adapter_id": "ha-home",
    "ha": {
      "base_url": "http://homeassistant:8123",
      "token": "<long-lived-access-token>",
      "entities": {
        "sens_grid_power_active": "sensor.evcc_grid_power",
        "sens_pv_production_active": "sensor.evcc_pv_power",
        "sens_ess_soc": "sensor.evcc_battery_soc",
        "sens_ess_power": "sensor.evcc_battery_power",
        "sens_evcs_active_power": "sensor.evcc_loadpoint_1_charge_power",
        "set_ess_active_power": "input_number.ess_active_power_w",
        "set_ess_charge_power_limit": "input_number.ess_charge_limit_w",
        "set_ess_discharge_power_limit": "input_number.ess_discharge_limit_w",
        "set_ess_mode": "input_number.ess_mode_hint",
        "set_evcs_max_current": "number.evcc_loadpoint_1_max_current"
      },
      "sign": {
        "sens_grid_power_active": "ehal",
        "sens_ess_power": "ehal"
      }
    }
  }
}
