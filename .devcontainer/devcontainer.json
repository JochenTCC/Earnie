{
  "name": "Earnie Dev (Python 3.14)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "EARNIE_ENV_PATH": "earnie_env",
    "EARNIE_UI_STREAMLIT_PORT": "8531",
    "EARNIE_AUTO_START_MAIN": "0",
    "EARNIE_UI_CHART_DEBUG_CAPTURE_ENABLED": "1",
    "EARNIE_VERIFY_LOXONE_ON_START": "0",
    "PYTHONUTF8": "1",
    "TZ": "Europe/Vienna"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8531, 8541],
  "portsAttributes": {
    "8531": {
      "label": "Streamlit (local dev)",
      "onAutoForward": "notify"
    },
    "8541": {
      "label": "Optimizer daemon HTTP",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests", "-q", "--tb=short"],
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ]
    }
  }
}
