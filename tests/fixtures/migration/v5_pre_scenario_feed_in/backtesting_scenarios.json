{
    "$schema": "./backtesting_scenarios.schema.json",
    "earnie_data_model": 5,
    "cbc_gap_rel": 0.2,
    "commit_hours": 24,
    "cbc_strict_time_limit_sec": 2,
    "scenarios": [
        {
            "id": "live",
            "label": "Live",
            "enabled": true,
            "own_reference": true,
            "settings": {
                "battery_ids": [
                    "15_kwh_speicher"
                ],
                "pv_system_ids": [
                    "dach_sued",
