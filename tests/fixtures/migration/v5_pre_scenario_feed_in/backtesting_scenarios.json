                ],
                "import_tariff_id": "at_tiwag_flex_privat",
                "export_tariff_id": "dynamic_epex",
                "house_profile_id": "profile_a"
            }
        },
        {
            "id": "flat_fixed",
            "label": "Flach, fixe Einspeise",
            "settings": {
                "k_push_cent": 3.7,
                "feed_in_mode": "fixed",
                "pv_kwp": 10,
                "battery_capacity_kwh": 5.0
            }
        },
        {
            "id": "flat_dynamic",
            "label": "Flach, dynamische Einspeise",
            "settings": {
                "k_push_cent": 3.7,
                "feed_in_mode": "dynamic_epex",
                "pv_kwp": 10,
                "battery_capacity_kwh": 5.0
            }
        },
        {
            "id": "tariff_with_leftover",
            "label": "Tarif plus Altfeld",
            "settings": {
                "import_tariff_id": "at_tiwag_flex_privat",
                "export_tariff_id": "dynamic_epex",
                "feed_in_mode": "fixed",
                "house_profile_id": "profile_a"
            }
        }
