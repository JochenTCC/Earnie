#!/bin/sh
# Bricht den Commit ab, wenn pytest tests fehlschlägt (nur bei Code-Änderungen).
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only | tr -d '\r')"
# Message-only --amend (index == HEAD): --cached is empty. Tree unchanged → skip.
if [ -z "$STAGED" ]; then
  echo "pre-commit: Keine gestagten Dateiänderungen (z. B. nur Commit-Message / --amend) — pytest übersprungen."
  exit 0
fi

# Skip full suite for docs / images / YAML / VS Code workspace / Cursor / GitHub
# workflow+notes / hook tooling.
# Git C-quotes non-ASCII names ("docs/assets/foo\303\274.png"), so ^docs/ alone misses them.
if ! echo "$STAGED" | grep -qvE '\.(md|png|ya?ml|code-workspace)"?$|^"?docs/|^"?\.cursor/|^"?\.github/|^"?\.githooks/'; then
  echo "pre-commit: Nur Doku/PNG/YAML/Workspace/Workflow/Hooks geändert — pytest übersprungen."
  exit 0
fi

# Linked worktrees (docs/workflow/parallel-sessions.md) have no own .venv:
# fall back to the main checkout's venv (parent of the shared .git dir).
MAIN_ROOT="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
PYTHON="python"
for CAND in ".venv/Scripts/python.exe" ".venv/bin/python" \
            "$MAIN_ROOT/.venv/Scripts/python.exe" "$MAIN_ROOT/.venv/bin/python"; do
  if [ -x "$CAND" ]; then
    PYTHON="$CAND"
    break
  fi
done

if ! command -v "$PYTHON" >/dev/null 2>&1 && ! [ -x "$PYTHON" ]; then
  echo "pre-commit: Python nicht gefunden (erwartet .venv oder python im PATH)." >&2
  exit 1
fi

echo "pre-commit: Starte Testsuite (pytest tests) ..."
mkdir -p .pytest_cache/test-metrics
# --maxfail: bei >=5 Fehlschlägen früh abbrechen. `slow`-Tests laufen dank
# conftest.pytest_collection_modifyitems zuletzt, sodass ein Abbruch wegen
# vieler früher Fehler die teuren MILP-Läufe gar nicht erst startet.
# scripts.run_pytest: native pytest wrapper (pre-commit entry point).
"$PYTHON" -m scripts.run_pytest tests -q --maxfail=5 --junitxml=.pytest_cache/test-metrics/junit-last.xml
"$PYTHON" -m scripts.test_health_report ingest --junit .pytest_cache/test-metrics/junit-last.xml
# Golden-master regression suite runs in .githooks/pre-push, not per commit.

echo "pre-commit: Tests bestanden."
